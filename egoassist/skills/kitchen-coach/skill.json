{
  "tasks": "tasks/*.json",
  "instruction_resources": ["references/safety-sources.md"],
  "default_task": "tomato-eggs",
  "activation_phrases": ["做菜", "做饭", "烹饪", "下厨", "cook", "cooking"],
  "allow_custom_tasks": true,
  "automatic_activation_requires_manifest_evidence": true,
  "capabilities": ["food-hygiene", "knife-safety", "heat-safety", "step-recovery"],
  "proactive_check_seconds": 4,
  "turn_taking": {
    "immediate_actions": ["guide", "silent"],
    "finish_clause_actions": ["ask", "correct"],
    "protected_actions": ["emergency"],
    "max_protection_ms": 2500
  },
  "artifacts": [
    {
      "id": "kitchen-coach-reference",
      "title": "Kitchen safety and checkpoint reference",
      "path": "references/kitchen-reference.pdf",
      "mediaType": "application/pdf",
      "tasks": ["*"],
      "steps": ["*"],
      "source": "bundled-reviewed-reference"
    }
  ],
  "tools": [
    {
      "name": "set_timer",
      "description": "Check a relative cooking deadline; the local adapter will explicitly report that alarm delivery is unsupported",
      "availability": {
        "status": "unsupported",
        "reason": "No durable workflow or acknowledged notification endpoint is connected."
      },
      "requires_confirmation": false,
      "handler": "builtin.relative-deadline.v1",
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seconds": {"type": "integer", "minimum": 1, "maximum": 86400, "default": 60},
          "label": {"type": "string", "maxLength": 80, "default": "当前任务"}
        },
        "required": ["seconds"]
      }
    },
    {
      "name": "request_human_help",
      "description": "Demo-only local acknowledgement; no external helper is contacted",
      "availability": {
        "status": "demo-only",
        "reason": "No external helper queue, connector receipt, or acknowledgement endpoint is configured."
      },
      "requires_confirmation": true,
      "handler": "builtin.local-acknowledgement.v1",
      "arguments": {"type": "object", "additionalProperties": false, "properties": {}},
      "result": {"status": "demo-only", "message": "No external helper or acknowledgement endpoint is connected."}
    }
  ]
}
