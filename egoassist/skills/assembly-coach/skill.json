{
  "tasks": "tasks/*.json",
  "default_task": "water-filter",
  "activation_phrases": ["组装家具", "装配家具", "组装净水器", "安装净水器", "assembly", "assemble", "flat-pack"],
  "allow_custom_tasks": true,
  "capabilities": ["part-verification", "orientation-check", "reversible-recovery"],
  "proactive_check_seconds": 5,
  "turn_taking": {
    "immediate_actions": ["guide", "silent", "correct"],
    "finish_clause_actions": ["ask"],
    "protected_actions": ["emergency"],
    "max_protection_ms": 1800
  },
  "memory_policy": {"write": "confirm", "trigger": ["task_id", "step_id"]},
  "artifacts": [
    {
      "id": "flat-pack-stool-reference",
      "title": "Flat-pack assembly safety reference",
      "path": "references/assembly-reference.pdf",
      "mediaType": "application/pdf",
      "tasks": ["flat-pack-stool"],
      "steps": ["*"],
      "source": "bundled-reviewed-reference"
    },
    {
      "id": "water-filter-reference",
      "title": "Water filter installation reference",
      "path": "references/water-filter-reference.pdf",
      "mediaType": "application/pdf",
      "tasks": ["water-filter"],
      "steps": ["*"],
      "source": "bundled-reviewed-reference"
    }
  ],
  "tools": [
    {
      "name": "show_reference",
      "description": "Open the reference artifact authorized for the current task checkpoint",
      "availability": {
        "status": "unsupported",
        "reason": "No task artifact resolver or browser viewer is connected."
      },
      "requires_confirmation": false,
      "handler": "builtin.artifact-reference.v1",
      "arguments": {"type": "object", "additionalProperties": false, "properties": {}},
      "result": {"status": "unsupported", "message": "No artifact resolver or viewer is connected."}
    },
    {
      "name": "request_human_help",
      "description": "Demo-only local acknowledgement; no remote expert is contacted",
      "availability": {
        "status": "demo-only",
        "reason": "No external expert queue, connector receipt, or acknowledgement endpoint is configured."
      },
      "requires_confirmation": true,
      "handler": "builtin.local-acknowledgement.v1",
      "arguments": {"type": "object", "additionalProperties": false, "properties": {}},
      "result": {"status": "demo-only", "message": "No external expert or acknowledgement endpoint is connected."}
    }
  ],
  "evaluation": ["intervention_precision", "step_order_accuracy", "recovery_success", "followup_reuse", "barge_in_success"]
}
