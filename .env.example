# ---- 复制本文件为 .env 并填入你的值（.env 已被 .gitignore 屏蔽，不会提交）----
# 密钥永远不要写进代码或提交到仓库。适配器会自动读取这些环境变量。

# 作答后端：mock / local / gemini / openai
EGOASSIST_BACKEND=mock

# 云端 API key（用哪个填哪个；本地 local 后端不需要）
GEMINI_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=
# 也可使用 DashScope SDK 的标准变量名；QWEN_API_KEY 优先。
DASHSCOPE_API_KEY=

# 实验回合语义分类：一次调用输出播报控制、任务控制、持久偏好、指代记忆和 Skill 选择
EGOASSIST_TURN_ROUTER_MODEL=qwen3-max
EGOASSIST_TURN_ROUTER_TIMEOUT=4.0
# Audio cache per response, up to 8 responses. Permissions persist; PCM does not.
EGOASSIST_PLAYBACK_CACHE_SECONDS=90
EGOASSIST_TURN_ACCUMULATE_MS=250

# Independent report requests; queued jobs survive server restart.
EGOASSIST_INSIGHT_MODEL=qwen-flash
EGOASSIST_INSIGHT_CONCURRENCY=2
EGOASSIST_INSIGHT_TIMEOUT=30
EGOASSIST_INSIGHT_JOB_TIMEOUT=45

# Complete interrupted questions as independent text answers.
EGOASSIST_ANSWER_MODEL=qwen-flash
EGOASSIST_ANSWER_CONCURRENCY=2
EGOASSIST_ANSWER_TIMEOUT=20
EGOASSIST_FOREGROUND_ANSWER_TIMEOUT=45

# 可选：可靠提醒。未配置 Temporal 时 set_timer 保持 unsupported。
EGOASSIST_TEMPORAL_TARGET=
EGOASSIST_TEMPORAL_NAMESPACE=default
EGOASSIST_TEMPORAL_TASK_QUEUE=egoassist-reminders-v1

# Optional mature realtime media transport. All three values are required;
# otherwise the bounded WebSocket media path remains the explicit fallback.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 可选：Temporal 提醒同时发送到 ntfy；留空时只进入持久 ResultInbox。
EGOASSIST_NTFY_SERVER=https://ntfy.sh
EGOASSIST_NTFY_TOPIC=
EGOASSIST_NTFY_TOKEN=

# Optional real human-help webhook. The browser must preview and explicitly
# consent to the exact payload before the server submits it.
EGOASSIST_HUMAN_HELP_WEBHOOK=
EGOASSIST_HUMAN_HELP_TOKEN=
EGOASSIST_HUMAN_HELP_TIMEOUT=8

# 无任务的被动观测（ADR 007）。能力默认开启，每位参与者仍需在控制台授权。
# 获得授权后按观察清单与采样间隔发送画面；未授权不发送。
# 撤回授权立即生效，连在途的那一帧也会被作废。
EGOASSIST_AMBIENT_MODE=1
# 观察清单路径（留空为开放环境观察，不限制行为与地点；可选专项清单）。
# 清单解析失败时 ambient 直接关闭，不会退回默认值。
EGOASSIST_AMBIENT_WATCHLIST=
# 默认采样间隔秒数，前端可按案例调节 2-120 秒，独立留存设置。
EGOASSIST_AMBIENT_INTERVAL_SECONDS=5

# 可选：覆盖默认模型与设备
EGOASSIST_LOCAL_MODEL=Qwen/Qwen3-VL-2B-Instruct
EGOASSIST_GEMINI_MODEL=gemini-2.5-flash
EGOASSIST_OPENAI_MODEL=gpt-4o
EGOASSIST_DEVICE=auto
# Maximum frames per CLIP forward pass; reduce this if GPU memory is limited.
EGOASSIST_EMBED_BATCH_SIZE=64

# 可选：把模型缓存放到项目内，便于清理/复现
HF_HOME=./.cache/huggingface

# Foreground visual evidence is question-specific; full scene analysis stays asynchronous.
EGOASSIST_VISUAL_QUESTION_MODEL=qwen3-vl-flash
# Includes waiting for the per-case concurrency slot as well as the provider request.
EGOASSIST_VISUAL_QUESTION_TIMEOUT=4
# Use scene only to reproduce the previous scene-first latency baseline.
EGOASSIST_VISUAL_QUESTION_MODE=focused
EGOASSIST_TOOL_MODEL=qwen3-max
EGOASSIST_TOOL_TIMEOUT=8
# Iterative tools: receipts return to the selector before dependent calls.
EGOASSIST_TOOL_MAX_ROUNDS=4
EGOASSIST_TOOL_MAX_CALLS=16
EGOASSIST_RESPONSE_QUEUE_LIMIT=16
# Historical observations retain capture time even after the live deadline.
EGOASSIST_PERCEPTION_TIMEOUT=8
EGOASSIST_LIVE_FRAME_MAX_AGE_MS=5000
# Segment ASR is independent from realtime ASR.
EGOASSIST_ASR_MODEL=qwen3-asr-flash
EGOASSIST_ASR_TIMEOUT=10
EGOASSIST_ASR_CONCURRENCY=2
# Memory-only retries never repeat commands or tool effects.
EGOASSIST_MEMORY_RECOVERY_TIMEOUT=20
EGOASSIST_MEMORY_RECOVERY_ATTEMPTS=3
EGOASSIST_MEMORY_RECOVERY_DELAY=5
EGOASSIST_MEMORY_RECOVERY_CONCURRENCY=1
