# ---- 复制本文件为 .env 并填入你的值（.env 已被 .gitignore 屏蔽，不会提交）----
# 密钥永远不要写进代码或提交到仓库。适配器会自动读取这些环境变量。

# 作答后端：mock / local / gemini / openai
EGOASSIST_BACKEND=mock

# 云端 API key（用哪个填哪个；本地 local 后端不需要）
GEMINI_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=
# 也可使用 DashScope SDK 的标准变量名；QWEN_API_KEY 优先。
DASHSCOPE_API_KEY=

# 实验回合语义分类：一次调用输出播报控制、任务控制、持久偏好、指代记忆和 Skill 选择
EGOASSIST_TURN_ROUTER_MODEL=qwen-flash
EGOASSIST_TURN_ROUTER_TIMEOUT=3.0
EGOASSIST_TURN_ACCUMULATE_MS=250

# 可选：可靠提醒。未配置 Temporal 时 set_timer 保持 unsupported。
EGOASSIST_TEMPORAL_TARGET=
EGOASSIST_TEMPORAL_NAMESPACE=default
EGOASSIST_TEMPORAL_TASK_QUEUE=egoassist-reminders-v1

# Optional mature realtime media transport. All three values are required;
# otherwise the bounded WebSocket media path remains the explicit fallback.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 可选：Temporal 提醒同时发送到 ntfy；留空时只进入持久 ResultInbox。
EGOASSIST_NTFY_SERVER=https://ntfy.sh
EGOASSIST_NTFY_TOPIC=
EGOASSIST_NTFY_TOKEN=

# Optional real human-help webhook. The browser must preview and explicitly
# consent to the exact payload before the server submits it.
EGOASSIST_HUMAN_HELP_WEBHOOK=
EGOASSIST_HUMAN_HELP_TOKEN=
EGOASSIST_HUMAN_HELP_TIMEOUT=8

# 可选：无任务的被动观测（ADR 007）。默认关闭——开启后摄像头会在用户未发起
# 任何任务时按固定间隔采样，因此必须由部署者显式开启，且每位参与者还要在控制台
# 单独授权一次；撤回授权立即生效，连在途的那一帧也会被作废。
EGOASSIST_AMBIENT_MODE=0
# 观察清单路径（留空使用内置的服药依从清单：只看厨房/餐桌/客厅，不含卧室与卫生间）。
# 清单解析失败时 ambient 直接关闭，不会退回默认值。
EGOASSIST_AMBIENT_WATCHLIST=
# 采样间隔秒数，最小 5。放大这个值就是直接减少被采集的画面数量。
EGOASSIST_AMBIENT_INTERVAL_SECONDS=20

# 可选：覆盖默认模型与设备
EGOASSIST_LOCAL_MODEL=Qwen/Qwen3-VL-2B-Instruct
EGOASSIST_GEMINI_MODEL=gemini-2.5-flash
EGOASSIST_OPENAI_MODEL=gpt-4o
EGOASSIST_DEVICE=auto
# Maximum frames per CLIP forward pass; reduce this if GPU memory is limited.
EGOASSIST_EMBED_BATCH_SIZE=64

# 可选：把模型缓存放到项目内，便于清理/复现
HF_HOME=./.cache/huggingface
